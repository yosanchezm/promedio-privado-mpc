{
  "name": "promedio-privado-mpc",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Aplicación web para cálculo de promedio salarial privado mediante Computación Multi-Parte Segura (MPC)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "docker:build": "docker build -t promedio-privado-mpc .",
    "docker:run": "docker run -p 8080:80 promedio-privado-mpc"
  },
  "dependencies": {
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^30.0.1",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
